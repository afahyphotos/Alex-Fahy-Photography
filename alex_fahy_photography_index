<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alex Fahy Photography</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: #090909;
  color: white;
}

nav {
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 6%;
  background: rgba(9,9,9,.85);
  backdrop-filter: blur(10px);
}

.logo {
  font-weight: bold;
  letter-spacing: 1px;
}

nav a {
  color: white;
  text-decoration: none;
  margin-left: 22px;
  font-size: 14px;
}

.hero {
  min-height: 85vh;
  display: flex;
  align-items: end;
  padding: 130px 7% 70px;
  background:
    linear-gradient(90deg,rgba(0,0,0,.75),rgba(0,0,0,.15)),
    url("hero.jpg") center/cover;
}

.hero h1 {
  font-size: clamp(42px,8vw,90px);
  line-height: .95;
}

.hero p {
  margin-top: 18px;
  font-size: 18px;
  color: #ccc;
}

section {
  padding: 90px 7%;
}

.section-title {
  font-size: 34px;
  margin-bottom: 35px;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(240px,1fr));
  gap: 20px;
}

.card {
  display: block;
  position: relative;
  min-height: 230px;
  border-radius: 12px;
  overflow: hidden;
  background: #151515;
  text-decoration: none;
  color: white;
}

.card img {
  width: 100%;
  height: 100%;
  min-height: 230px;
  object-fit: cover;
  transition: .3s;
}

.card:hover img {
  transform: scale(1.04);
  opacity: .75;
}

.card-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28px 20px 18px;
  background: linear-gradient(transparent,rgba(0,0,0,.9));
  font-weight: bold;
  letter-spacing: 1px;
}

.about {
  max-width: 850px;
  color: #ccc;
  font-size: 18px;
}

footer {
  text-align: center;
  padding: 50px 7%;
  border-top: 1px solid #222;
  color: #777;
}

@media(max-width:600px) {
  nav {
    padding: 16px 5%;
  }

  nav a {
    margin-left: 10px;
    font-size: 12px;
  }

  .hero {
    min-height: 75vh;
    padding: 110px 6% 50px;
  }

  section {
    padding: 65px 6%;
  }

  .section-title {
    font-size: 28px;
  }
}
</style>
</head>

